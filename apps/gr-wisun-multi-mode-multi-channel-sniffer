"""Sniffer application to receive a multiple Wi-SUN channels for packet analysis with Wireshark."""

import re
import sys
from argparse import ArgumentDefaultsHelpFormatter, ArgumentParser
from collections import OrderedDict

import osmosdr
from gnuradio import blocks, gr, pdu, wisun
from gnuradio.wisun.cli import (
    add_channel_mask_argument,
    add_list_arguments,
    add_receiver_arguments,
    build_configuration,
    ensure_fifo,
    handle_list_arguments,
    run_until_interrupted,
)
from gnuradio.wisun.parameters import (
    SUN_FSK_CHANNEL_PAGE,
    WISUN_FREQUENCY_BAND_802154_MAPPING,
)
from gnuradio.wisun.util import tabular_pretty_print


class GrWisunMultiModeMultiChannelSniffer(gr.top_block):
    """Multi-mode multi-channel sniffer main class."""

    def __init__(self, device_string, gain, sample_rate, center_frequency, dest_file, wisun_configs):
        """Build one multi-channel receiver per Wi-SUN mode."""
        gr.top_block.__init__(self)

        ##################################################
        # Blocks
        ##################################################
        if device_string is None:
            osmosdr_source = osmosdr.source()
        else:
            osmosdr_source = osmosdr.source(device_string)
        osmosdr_source.set_sample_rate(sample_rate)
        osmosdr_source.set_center_freq(center_frequency, 0)
        osmosdr_source.set_gain_mode(False, 0)
        osmosdr_source.set_gain(gain, 0)
        osmosdr_source.set_if_gain(0, 0)
        osmosdr_source.set_bb_gain(0, 0)
        osmosdr_source.set_bandwidth(0, 0)

        pdu_to_tagged_stream = pdu.pdu_to_tagged_stream(gr.types.byte_t, 'packet_len')
        file_sink = blocks.file_sink(gr.sizeof_char*1, dest_file, False)
        file_sink.set_unbuffered(True)

        receivers = []
        for wisun_config in wisun_configs:
            radio_config = wisun_config.radio_configuration()
            metadata = {
                "packet-bit-rate": radio_config.data_rate(),
                "packet-channel-page": SUN_FSK_CHANNEL_PAGE,
                "packet-phy-band": WISUN_FREQUENCY_BAND_802154_MAPPING[wisun_config.channel_plan_id],
            }
            if radio_config.is_valid_802154_phy_mode():
                phy_type, phy_mode = radio_config.get_802154_phy_type_mode()
                metadata['packet-phy-type'] = phy_type
                metadata['packet-phy-mode'] = phy_mode

            print(f"Setting up multi-channel receiver for Wi-SUN configuration [{wisun_configs.index(wisun_config)}]:")
            multi_channel_receiver = wisun.multi_channel_receiver(sample_rate,
                                                                  center_frequency,
                                                                  radio_config.channel_0_center_frequency,
                                                                  radio_config.channel_spacing,
                                                                  radio_config.symbol_rate,
                                                                  radio_config.channels,
                                                                  fec=wisun_config.uses_fec(),
                                                                  metadata=metadata,
                                                                  channels_outside_mask=
                                                                  wisun_config.channels_outside_mask())
            receivers.append(multi_channel_receiver)

        ##################################################
        # Connections
        ##################################################
        for receiver in receivers:
            self.connect((osmosdr_source, 0), (receiver, 0))
            self.msg_connect((receiver, 'pdus'), (pdu_to_tagged_stream, 'pdus'))
        self.connect((pdu_to_tagged_stream, 0), (file_sink, 0))


def parse_mode(mode, index, regulatory_domain, mask_channels_only):
    """Parse one `channel plan, PHY type, PHY mode` triple into a configuration."""
    if not re.match(r"^\d+,\d+,\d+$", mode):
        sys.stderr.write(f"Error: invalid mode '{mode}'\n")
        sys.stderr.write("Please specify mode as tuple of channel plan ID, PHY type, PHY mode, e.g. '32,0,1'.\n")
        sys.exit(1)
    channel_plan_id, phy_type, phy_mode = (int(x) for x in mode.split(','))
    return build_configuration(regulatory_domain=regulatory_domain,
                               channel_plan_id=channel_plan_id,
                               phy_mode_id=(phy_type << 4) + phy_mode,
                               mask_channels_only=mask_channels_only,
                               label=f" [{index}]")


def write_flow_graph(sniffer, path):
    """Write the flow graph in Graphviz dot format; only possible once it is running."""
    with open(path, 'w') as f:
        f.write("digraph gr_wisun_multi_mode_multi_channel_sniffer {\n")
        f.write(sniffer.edge_list())
        f.write("\nedge [style=dashed]\n")
        f.write(sniffer.msg_edge_list())
        f.write("}\n")


def main():
    """Parse the command line and run one multi-channel sniffer per requested mode."""
    parser = ArgumentParser(description="Multi mode, multi channel Wi-SUN sniffer.",
                            formatter_class=ArgumentDefaultsHelpFormatter)
    add_receiver_arguments(parser)
    add_channel_mask_argument(parser)
    parser.add_argument('-s', '--sample-rate', type=float, default=8e6, help="SDR hardware sample rate [Hz]")
    parser.add_argument('-f', '--frequency', type=float, default=866.1e6, help="SDR hardware center frequency [Hz]")
    parser.add_argument('-r', '--regulatory-domain', type=str, default="EU", help="Wi-SUN regulatory domain")
    parser.add_argument('-m', '--mode', action='append', default=[],
                        help="Wi-SUN mode to receive (tuple with channel plan ID, PHY type, PHY mode). "
                        "Repeat argument for multiple modes.")
    add_list_arguments(parser)
    parser.add_argument('--flow-graph-file', type=str, default=None,
                        help="Write flow-graph to given file (Graphviz dot format).")
    args = parser.parse_args()

    handle_list_arguments(args)
    ensure_fifo(args.dest_file)

    if len(args.mode) == 0:
        sys.stderr.write("Please specify at least one mode with '-m'.\n")
        sys.exit(1)

    print("Receiver settings:")
    tabular_pretty_print(OrderedDict([
        ("Sample rate", f"{args.sample_rate / 1e6:.1f} MHz"),
        ("Frequency", f"{args.frequency / 1e6:.1f} MHz"),
        ("Gain", f"{args.gain}"),
    ]))

    configs = [parse_mode(mode, i, args.regulatory_domain, args.mask_channels_only)
               for i, mode in enumerate(args.mode)]

    sniffer = GrWisunMultiModeMultiChannelSniffer(args.device,
                                                 args.gain,
                                                 args.sample_rate,
                                                 args.frequency,
                                                 args.dest_file,
                                                 configs)

    # the flow graph can only be dumped once it is running, so it happens from the callback
    after_start = (None if args.flow_graph_file is None
                   else lambda: write_flow_graph(sniffer, args.flow_graph_file))

    run_until_interrupted(sniffer, after_start=after_start)


if __name__ == '__main__':
    main()
