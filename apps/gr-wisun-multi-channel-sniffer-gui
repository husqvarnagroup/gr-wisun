"""GUI sniffer application to receive a multiple Wi-SUN channels for packet analysis with Wireshark."""

import signal
import sys
from argparse import ArgumentDefaultsHelpFormatter, ArgumentParser

import sip
from gnuradio import qtgui
from gnuradio.fft import window
from gnuradio.wisun.cli import (
    add_list_arguments,
    add_mode_arguments,
    add_receiver_arguments,
    build_configuration,
    ensure_fifo,
    handle_list_arguments,
)
from gnuradio.wisun.multi_channel_sniffer import MultiChannelSniffer
from PyQt5 import Qt, QtCore

FFT_SIZE = 4096


class GuiMultiChannelSniffer(MultiChannelSniffer, Qt.QWidget):
    """The multi-channel sniffer with a spectrum and waterfall plot of the received signal.

    The signal processing is exactly MultiChannelSniffer's; everything here is the GUI.
    """

    def __init__(self, device_string, gain, dest_file, wisun_config, update_rate):
        """Build the flow graph and the GUI for the given configuration."""
        MultiChannelSniffer.__init__(self, device_string, gain, dest_file, wisun_config,
                                     name="Multi-Channel Wi-SUN FSK Sniffer", catch_exceptions=True)

        Qt.QWidget.__init__(self)
        self.setWindowTitle("Multi-Channel Wi-SUN FSK Sniffer")
        try:
            self.setWindowIcon(Qt.QIcon.fromTheme('gnuradio-grc'))
        # a missing icon theme must not stop the sniffer; BaseException is what the
        # GRC-generated code catches here
        except BaseException as exc:  # noqa: BLE001
            print(f"Qt GUI: Could not set Icon: {exc!s}", file=sys.stderr)
        self._layout_top = Qt.QVBoxLayout()
        self.setLayout(self._layout_top)
        self._scroll_area = Qt.QScrollArea()
        self._layout_top.addWidget(self._scroll_area)
        self._scroll_area.setWidgetResizable(True)
        self._top_widget = Qt.QWidget()
        self._scroll_area.setWidget(self._top_widget)
        self._layout_main_area = Qt.QVBoxLayout(self._top_widget)
        self._settings = Qt.QSettings("gnuradio/flowgraphs", "gr_wisun_multi_channel_sniffer_gui")
        try:
            geometry = self._settings.value("geometry")
            if geometry:
                self.restoreGeometry(geometry)
        # an unreadable saved geometry must not stop the sniffer
        except BaseException as exc:  # noqa: BLE001
            print(f"Qt GUI: Could not restore geometry: {exc!s}", file=sys.stderr)

        ##################################################
        # GUI Elements & Connections
        ##################################################
        gain_range = qtgui.Range(0, 70, 1, 10, 200)
        gain_slider = qtgui.RangeWidget(gain_range, self.set_gain, "Source Gain", "counter_slider", float,
                                        QtCore.Qt.Horizontal)
        self._layout_main_area.addWidget(gain_slider)

        spectrum_sink = qtgui.freq_sink_c(
            FFT_SIZE,
            window.WIN_BLACKMAN_HARRIS,
            self.center_frequency,
            self.sample_rate,
            "OsmoSDR Source Signal FFT")
        spectrum_sink.set_update_time(update_rate)
        spectrum_sink.set_y_axis(-140, -20)
        spectrum_sink.set_y_label('Relative Gain', 'dB')
        spectrum_sink.enable_autoscale(False)
        spectrum_sink.enable_grid(True)
        spectrum_sink.enable_axis_labels(True)
        spectrum_sink.enable_control_panel(True)
        spectrum_sink_wrapped = sip.wrapinstance(spectrum_sink.qwidget(), Qt.QWidget)
        self._layout_main_area.addWidget(spectrum_sink_wrapped)
        self.connect((self.osmosdr_source, 0), (spectrum_sink, 0))

        waterfall_sink = qtgui.waterfall_sink_c(
            FFT_SIZE,
            window.WIN_BLACKMAN_HARRIS,
            self.center_frequency,
            self.sample_rate,
            "OsmoSDR Source Signal Waterfall")
        waterfall_sink.set_update_time(update_rate)
        waterfall_sink.enable_axis_labels(True)
        waterfall_sink_wrapped = sip.wrapinstance(waterfall_sink.qwidget(), Qt.QWidget)
        self._layout_main_area.addWidget(waterfall_sink_wrapped)
        self.connect((self.osmosdr_source, 0), (waterfall_sink, 0))

    def closeEvent(self, event):
        """Save the window geometry and stop the flow graph when the window is closed."""
        self._settings = Qt.QSettings("gnuradio/flowgraphs", "gr_wisun_multi_channel_sniffer_gui")
        self._settings.setValue("geometry", self.saveGeometry())
        self.stop()
        self.wait()

        event.accept()

    def set_gain(self, gain):
        """Set the receiver gain, called by the GUI slider."""
        self.osmosdr_source.set_gain(gain, 0)


def parse_channels(text):
    """Parse a comma-separated channel list; an empty one means every channel."""
    return [] if len(text) == 0 else [int(channel) for channel in text.split(',')]


def main():
    """Parse the command line and run the sniffer with its GUI."""
    parser = ArgumentParser(description="Multi channel Wi-SUN sniffer with GUI.",
                            formatter_class=ArgumentDefaultsHelpFormatter)
    add_receiver_arguments(parser)
    add_mode_arguments(parser)
    parser.add_argument('-c', '--channels', type=str, default="",
                        help="Wi-SUN channels to receive; empty: all channels")
    add_list_arguments(parser)
    parser.add_argument('-R', '--update-rate', type=float, default=0.01,
                        help="FFT & waterfall update rate [s]")
    args = parser.parse_args()

    handle_list_arguments(args)
    ensure_fifo(args.dest_file)

    config = build_configuration(regulatory_domain=args.regulatory_domain,
                                 channel_plan_id=args.channel_plan,
                                 phy_mode_id=(args.phy_type << 4) + args.phy_mode,
                                 allowed_channels=parse_channels(args.channels))

    qapp = Qt.QApplication(sys.argv)
    sniffer = GuiMultiChannelSniffer(args.device, args.gain, args.dest_file, config, args.update_rate)

    # not cli.run_until_interrupted: this one has to leave the Qt event loop rather than
    # exit, so that closeEvent runs and the window geometry is saved
    def handle_signal(sig=None, frame=None):
        sniffer.stop()
        sniffer.wait()
        Qt.QApplication.quit()

    signal.signal(signal.SIGINT, handle_signal)
    signal.signal(signal.SIGTERM, handle_signal)

    sniffer.start()
    sniffer.show()
    qapp.exec_()


if __name__ == '__main__':
    main()
